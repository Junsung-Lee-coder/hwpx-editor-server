# Redacted local settings template.
# Copy this file to .env on a private Windows machine. Never commit .env.
HWP_API_HOST=127.0.0.1
HWP_API_PORT=8765
HWP_SPOOL_ROOT=./spool
HWP_ALLOWED_EXTENSIONS=.hwpx,.hwp
HWP_MAX_UPLOAD_MB=50
HWP_POLL_INTERVAL_SECONDS=3
HWP_JOB_TIMEOUT_SECONDS=300
HWP_JOB_STALE_SECONDS=900
HWP_MAX_ATTEMPTS=2
HWP_LOG_LEVEL=INFO
HWP_RETENTION_DAYS=7
HWP_WORKER_NAME=hwpx-worker
HWP_SECURITY_MODULE_DLL=FilePathCheckDLL
HWP_SECURITY_MODULE_NAME=FilePathCheckerModule
